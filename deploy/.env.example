# Synthetic values for an isolated loopback-only development stack.
# These are dummy development credentials, not the root Qwen API key.
PG_USER=video_summary
PG_PASSWORD=local-dev-only
PG_DB=video_summary
OBJECT_ACCESS_KEY=local-dev-only
OBJECT_SECRET_KEY=local-dev-only

# S3-03 local HTTP defaults. Enable secure cookies when deploying behind HTTPS.
AUTH_SESSION_SECONDS=28800
AUTH_COOKIE_SECURE=false
AUTH_ACCOUNT_LIMIT=5
AUTH_SOURCE_LIMIT=20
AUTH_REGISTER_SOURCE_LIMIT=20
AUTH_WINDOW_SECONDS=900
AUTH_BLOCK_SECONDS=900

# S3-04 admission / validation defaults, not product performance promises.
IMPORT_CONCURRENCY=5
IMPORT_UPLOAD_TIMEOUT_SECONDS=1800
IMPORT_DOWNLOAD_TIMEOUT_SECONDS=1800
MEDIA_PROBE_TIMEOUT_SECONDS=30
MEDIA_DECODE_TIMEOUT_SECONDS=3600

# S3-06 local scheduling defaults; no model execution handler is enabled yet.
QUEUE_GLOBAL_CONCURRENCY=1
WORKER_LEASE_SECONDS=120
WORKER_HEARTBEAT_SECONDS=30
WORKER_POLL_SECONDS=1

WORKER_SHUTDOWN_SECONDS=5
TASK_DB_TIMEOUT_SECONDS=5

# S3-07 local preprocessing defaults; no production model adapter is enabled.
PREPROCESS_FRAME_INTERVAL_SECONDS=10
PREPROCESS_FRAME_WIDTH=768
PREPROCESS_TIMEOUT_SECONDS=3600
MODEL_ADAPTER_TIMEOUT_SECONDS=120

# S3-08: offline synthetic outputs only; disabled mode leaves tasks queued.
WORKER_PROCESSOR_MODE=offline
# Only remove one complete JSON code fence; no paid regeneration.
OUTPUT_REPAIR_ATTEMPTS=1

# S3-09 operational defaults, not retention extensions.
CLEANUP_POLL_SECONDS=5
CLEANUP_RETRY_SECONDS=60
# Keep false until a complete backup inventory and its cleanup are verified.
BACKUP_INVENTORY_CONFIRMED=false

# Optional public feedback email; empty hides the footer.
SUPPORT_EMAIL=
