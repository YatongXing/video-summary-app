# Copy this file to .env on your own computer. Never commit the real key.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://maas.qianwenaiapi.com/compatible-mode/v1
QWEN_MODEL=qwen3.8-omni-flash

# Optional private OSS transfer. Set all four fields together.
QWEN_OSS_REGION=
QWEN_OSS_BUCKET=
QWEN_OSS_ACCESS_KEY_ID=
QWEN_OSS_ACCESS_KEY_SECRET=

# Optional public feedback email; empty hides the footer.
SUPPORT_EMAIL=
